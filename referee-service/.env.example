PORT=3002
NODE_ENV=development

# Base de datos propia del Referee Service (Database per Service)
DATABASE_URL="postgresql://referee_user:referee_pass@referee-db:5432/referee_db?schema=public"

# Bus de eventos asincrono (consume fixture.published)
REDIS_URL="redis://redis:6379"

# Token interno: solo el API Gateway y los demas servicios pueden llamar a este servicio.
# Mismo secreto en los nueve servicios, distinto del JWT; en Render es una variable secreta.
INTERNAL_TOKEN=""
# enforce (rechaza sin token) | report (solo registra) | off. Sin definir: enforce si hay INTERNAL_TOKEN
INTERNAL_AUTH=""
