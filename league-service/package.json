{
  "name": "league-service",
  "version": "1.0.0",
  "description": "SportsLeague - League Service (ligas, temporadas, categorias y reglamento)",
  "author": "SportsLeague Team",
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "jest",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev"
  },
  "dependencies": {
    "@nestjs/common": "^10.3.0",
    "@nestjs/config": "^3.2.0",
    "@nestjs/core": "^10.3.0",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/swagger": "^7.4.0",
    "@prisma/client": "^5.10.0",
    "@scalar/nestjs-api-reference": "^0.4.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "prisma": "^5.10.0",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@nestjs/cli": "^10.3.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.11.0",
    "eslint": "^9.20.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.0",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.24.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "roots": [
      "<rootDir>/src"
    ],
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "diagnostics": false
        }
      ]
    },
    "moduleNameMapper": {
      "^@prisma/client$": "<rootDir>/test/prisma-client.mock.ts"
    },
    "testEnvironment": "node"
  }
}
