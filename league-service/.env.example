PORT=3003
NODE_ENV=development

# Base de datos propia del League Service (Database per Service)
DATABASE_URL="postgresql://league_user:league_pass@league-db:5432/league_db?schema=public"


# Token interno: solo el API Gateway y los demas servicios pueden llamar a este servicio.
# Mismo secreto en los nueve servicios, distinto del JWT; en Render es una variable secreta.
INTERNAL_TOKEN=""
# enforce (rechaza sin token) | report (solo registra) | off. Sin definir: enforce si hay INTERNAL_TOKEN
INTERNAL_AUTH=""

# Fixture Service: el League Service lo consulta para validar ediciones (calendario de una temporada)
FIXTURE_SERVICE_URL="http://localhost:3001"
