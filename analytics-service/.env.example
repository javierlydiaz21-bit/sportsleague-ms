PORT=3008
NODE_ENV=development

# Base de datos propia del Analytics Service (KPIs calculados por el ETL)
DATABASE_URL="postgresql://analytics_user:analytics_pass@analytics-db:5432/analytics_db?schema=public"

# Replicas de solo lectura de las bases operativas (documento 2.8). Las conexiones
# se abren en modo solo lectura; en docker compose apuntan a las bases principales.
FIXTURE_REPLICA_URL="postgresql://fixture_user:fixture_pass@fixture-db:5432/fixture_db"
LIVE_SCORE_REPLICA_URL="postgresql://live_score_user:live_score_pass@live-score-db:5432/live_score_db"
STATISTICS_REPLICA_URL="postgresql://statistics_user:statistics_pass@statistics-db:5432/statistics_db"

# Cada cuantos segundos corre el ETL
ETL_INTERVAL_SECONDS=60
# Personas en la cancha por cada espectador conectado al marcador en vivo
ATTENDANCE_FACTOR=1
