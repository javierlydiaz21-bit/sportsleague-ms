PORT=3005
NODE_ENV=development

# Base de datos propia del Live Score Service (Database per Service)
DATABASE_URL="postgresql://live_score_user:live_score_pass@live-score-db:5432/live_score_db?schema=public"

# Bus de eventos asincrono (publica match.event y match.completed; consume fixture.published)
REDIS_URL="redis://redis:6379"

# Respaldo REST si fixture.published no llego (documento 3.8)
FIXTURE_SERVICE_URL="http://fixture-service:3001"
TEAM_SERVICE_URL="http://team-service:3004"

# Origenes permitidos para el WebSocket /live-scores (documento 7.2), separados por coma
WS_ALLOWED_ORIGINS=""
