PORT=3007
NODE_ENV=development

# Base de datos propia del Notification Service (preferencias y avisos generados)
DATABASE_URL="postgresql://notification_user:notification_pass@notification-db:5432/notification_db?schema=public"

# Bus de eventos asincrono (consume fixture.published, fixture.venue_changed, match.completed y match.suspended)
REDIS_URL="redis://redis:6379"

# Nombre de los equipos para redactar los avisos (consulta REST puntual, documento 3.8)
TEAM_SERVICE_URL="http://team-service:3004"

# Token interno: solo el API Gateway y los demas servicios pueden llamar a este servicio.
# Mismo secreto en los nueve servicios, distinto del JWT; en Render es una variable secreta.
INTERNAL_TOKEN=""
# enforce (rechaza sin token) | report (solo registra) | off. Sin definir: enforce si hay INTERNAL_TOKEN
INTERNAL_AUTH=""
