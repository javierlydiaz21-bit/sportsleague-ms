PORT=8080
NODE_ENV=development

# Base de datos del gateway: usuarios y refresh tokens
DATABASE_URL="postgresql://gateway_user:gateway_pass@gateway-db:5432/gateway_db?schema=public"

# Redis: contadores del rate limiting compartidos entre instancias
REDIS_URL="redis://redis:6379"

# Autenticacion (documento 7.2 y 10.1). Use un secreto largo y aleatorio en produccion.
JWT_SECRET="cambie-este-secreto-en-produccion"
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_DAYS=7

# Organizador inicial (se crea al arrancar si no existe)
ADMIN_EMAIL=admin@sportsleague.co
ADMIN_PASSWORD=admin12345

# Rate limiting por IP y por minuto (documento 5.3)
RATE_LIMIT_READ=600
RATE_LIMIT_WRITE=120

# CORS (documento 10.7): dominios autorizados, separados por coma (ej: la URL de Vercel)
CORS_ORIGINS=""

# Microservicios internos
LEAGUE_SERVICE_URL="http://league-service:3003"
TEAM_SERVICE_URL="http://team-service:3004"
FIXTURE_SERVICE_URL="http://fixture-service:3001"
REFEREE_SERVICE_URL="http://referee-service:3002"
LIVE_SCORE_SERVICE_URL="http://live-score-service:3005"
STATISTICS_SERVICE_URL="http://statistics-service:3006"
NOTIFICATION_SERVICE_URL="http://notification-service:3007"
ANALYTICS_SERVICE_URL="http://analytics-service:3008"
