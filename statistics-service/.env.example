PORT=3006
NODE_ENV=development

# Base de datos propia del Statistics Service (Database per Service)
DATABASE_URL="postgresql://statistics_user:statistics_pass@statistics-db:5432/statistics_db?schema=public"

# Bus de eventos asincrono (consume match.completed) y cache de las tablas de posiciones
REDIS_URL="redis://redis:6379"

# Comunicacion sincrona: reglamento de puntuacion (documento 2.6 y 4.1)
LEAGUE_SERVICE_URL="http://league-service:3003"

# Token interno: solo el API Gateway y los demas servicios pueden llamar a este servicio.
# Mismo secreto en los nueve servicios, distinto del JWT; en Render es una variable secreta.
INTERNAL_TOKEN=""
# enforce (rechaza sin token) | report (solo registra) | off. Sin definir: enforce si hay INTERNAL_TOKEN
INTERNAL_AUTH=""
